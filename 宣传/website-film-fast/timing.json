  "captions": [
    {
      "start": 0.35,
      "end": 3.6165625,
      "text": "打开 Miku Camera，拍摄初音水印合影。"
    },
    {
      "start": 4.85,
      "end": 8.049229166666667,
      "text": "取景时预览水印，时间地点一起保留。"
    },
    {
      "start": 9.35,
      "end": 13.612229166666665,
      "text": "选择或新建预设，上传图片，自由调整水印样式。"
    },
    {
      "start": 14.85,
      "end": 18.4941875,
      "text": "保存多套接口配置，随时切换服务和模型。"
    },
    {
      "start": 19.85,
      "end": 23.853208333333335,
      "text": "设好默认模式、提示词和参考图，下次直接用。"
    },
    {
      "start": 24.35,
      "end": 28.510833333333334,
      "text": "导入照片，选择形象、服装和分辨率，开始创作。"
    },
    {
      "start": 29.85,
      "end": 33.744625,
      "text": "生成时回到桌面，悬浮窗随时查看多项任务。"
    },
    {
      "start": 34.85,
      "end": 38.29691666666666,
      "text": "同一处风景，试试二次元和真人两种形象。"
    },
    {
      "start": 39.35,
      "end": 43.84710416666667,
      "text": "也能换上参考造型，长按对比原图，再保存喜欢的结果。"
    },
    {
      "start": 45.35,
      "end": 49.03195833333333,
      "text": "打开项目主页，下载 Miku Camera，开始拍摄。"
    }
  ],
  "voice": "zh-CN-XiaoxiaoNeural"
}