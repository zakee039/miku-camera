  "captions": [
    {
      "start": 0.6,
      "end": 3.2014375000000004,
      "text": "今天，也和 Miku 一起。"
    },
    {
      "start": 3.3414375000000005,
      "end": 7.043958333333333,
      "text": "把喜欢拍进生活里，让她陪你收藏普通的一天。"
    },
    {
      "start": 8.4,
      "end": 11.3799375,
      "text": "打开相机，给 Miku 留个位置。"
    },
    {
      "start": 11.519937500000001,
      "end": 15.429104166666667,
      "text": "可爱的合影水印，和时间地点一起，记住这一刻。"
    },
    {
      "start": 16.8,
      "end": 18.794937500000003,
      "text": "可爱这件事，你说了算。"
    },
    {
      "start": 18.9349375,
      "end": 23.32360416666667,
      "text": "换一张喜欢的图片，自由摆放，再收进自己的水印预设。"
    },
    {
      "start": 24.666666666666668,
      "end": 26.574937500000004,
      "text": "让想象，走进这一张。"
    },
    {
      "start": 26.7149375,
      "end": 32.09760416666667,
      "text": "选好照片，确认提示词和参考图，让 AI 创作她与风景的互动。"
    },
    {
      "start": 33.46666666666667,
      "end": 35.62566666666667,
      "text": "二次元，或者真人写实。"
    },
    {
      "start": 35.76566666666667,
      "end": 39.696645833333335,
      "text": "同一处风景，遇见不同的 Miku，一样让人心动。"
    },
    {
      "start": 41.06666666666667,
      "end": 43.24597916666667,
      "text": "换一个造型，再心动一次。"
    },
    {
      "start": 43.38597916666667,
      "end": 47.468500000000006,
      "text": "服装、参考图和分辨率，都可以按你的喜欢来选择。"
    },
    {
      "start": 48.833333333333336,
      "end": 50.713520833333334,
      "text": "把这一刻，好好收藏。"
    },
    {
      "start": 50.853520833333334,
      "end": 55.3231875,
      "text": "对比原图，保存 AI 图、原图，或者两张都留着。"
    },
    {
      "start": 56.66666666666667,
      "end": 59.59216666666667,
      "text": "Miku Camera，下一张照片，一起吧。"
    },
    {
      "start": 59.73216666666667,
      "end": 63.66010416666667,
      "text": "带上 Miku 出门，让喜欢，出现在生活里。"
    }
  ]
}